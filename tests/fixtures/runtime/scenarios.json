{
  "schema_version": "1",
  "label": "replay_conformance_only_not_a_real_provider_benchmark",
  "scenarios": [
    {
      "scenario_id": "prepare-form",
      "dry_run": false,
      "request": {
        "run_id": "run-prepare",
        "attempt_id": "attempt-prepare",
        "agent_role": "form-preparer",
        "phase": "prepare",
        "objective": "Prepare an application without submitting it",
        "available_tools": ["browser_snapshot", "browser_fill_form"],
        "control_route": {
          "interaction_driver": "playwright",
          "browser_runtime": "edge",
          "phase": "prepare",
          "reason_code": "primary_playwright"
        },
        "interaction_mode": "auto"
      },
      "expected": {
        "status": "ready_to_submit",
        "receipt": false,
        "conflict": false,
        "tools": ["browser_snapshot", "browser_fill_form"],
        "side_effects": ["read", "write"],
        "max_latency_ms": 500
      }
    },
    {
      "scenario_id": "submit-with-receipt",
      "dry_run": false,
      "request": {
        "run_id": "run-receipt",
        "attempt_id": "attempt-receipt",
        "agent_role": "submit-owner",
        "phase": "submit",
        "objective": "Classify a recorded submission turn",
        "available_tools": ["browser_click", "browser_snapshot"],
        "control_route": {
          "interaction_driver": "playwright",
          "browser_runtime": "edge",
          "phase": "submit",
          "reason_code": "primary_playwright"
        },
        "interaction_mode": "playwright"
      },
      "expected": {
        "status": "applied",
        "receipt": true,
        "conflict": false,
        "tools": ["browser_click", "browser_snapshot"],
        "side_effects": ["write", "read"],
        "max_latency_ms": 500
      }
    },
    {
      "scenario_id": "submit-conflict-fails-closed",
      "dry_run": false,
      "request": {
        "run_id": "run-conflict",
        "attempt_id": "attempt-conflict",
        "agent_role": "submit-owner",
        "phase": "submit",
        "objective": "Fail closed when recorded outputs disagree",
        "available_tools": ["browser_click"],
        "control_route": {
          "interaction_driver": "playwright",
          "browser_runtime": "edge",
          "phase": "submit",
          "reason_code": "primary_playwright"
        },
        "interaction_mode": "playwright"
      },
      "expected": {
        "status": "submission_uncertain",
        "receipt": false,
        "conflict": true,
        "tools": ["browser_click"],
        "side_effects": ["write"],
        "max_latency_ms": 500
      }
    }
  ],
